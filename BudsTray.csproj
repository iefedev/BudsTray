<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BudsTray</AssemblyName>
    <RootNamespace>BudsTray</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>0.2.0</Version>
    <Product>BudsTray</Product>
    <Description>Windows tray app for switching between Bluetooth headphones.</Description>
    <Authors>iefedev</Authors>
    <Company>iefedev</Company>
    <Copyright>Copyright (c) 2026 iefedev</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- English only: no localized framework resources in the output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives below this folder; keep its files out of the app. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <InternalsVisibleTo Include="BudsTray.Tests" />
  </ItemGroup>

</Project>
